# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Packaging / build output
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/
virtualenv/

# Local secrets and environment files
.env
.env.*
!.env.example

# Local Django database, logs and uploaded media
*.sqlite3
*.sqlite3-journal
*.log
media/

# Collected static assets (generated by `collectstatic`)
staticfiles/

# Sphinx: ignore the build cache only. The generated HTML in
# docs/_build/html is committed on purpose so that readers of the
# repository can open the documentation directly.
docs/_build/doctrees/

# Editors and operating system files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
