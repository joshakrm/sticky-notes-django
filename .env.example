# Copy this file to ".env" and fill in your own values.
# The real ".env" file is ignored by Git and must never be committed.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-your-own-secret-key

# Use "True" for local development and "False" in production.
DJANGO_DEBUG=True

# Comma-separated list of host names the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
